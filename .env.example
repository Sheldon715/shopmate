PORT=3000
HOST=
NODE_ENV=development
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=

DATABASE_URL=
JWT_SECRET=

SHOPMATE_RAW_DATA_DIR=./data/raw
SHOPMATE_PROCESSED_DATA_DIR=./data/processed
SHOPMATE_RAG_DATA_DIR=./data/processed/rag
SHOPMATE_STATIC_IMAGE_ROOT=./data/raw/ecommerce_agent_dataset_v3
PUBLIC_IMAGE_BASE_URL=

IMPORT_DRY_RUN=true
IMPORT_STRICT=false

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PRODUCTS=shopmate_product_documents

EMBEDDING_PROVIDER=volcengine-ark
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=doubao-embedding-vision-250615
EMBEDDING_DIMENSIONS=2048
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000
EMBEDDING_MAX_RETRIES=3
EMBEDDING_ENDPOINT_KIND=multimodal_embeddings

# Image vector V2 defaults stay disabled until a real image embedding provider is configured.
IMAGE_EMBEDDING_PROVIDER=disabled
IMAGE_EMBEDDING_BASE_URL=
IMAGE_EMBEDDING_API_KEY=
IMAGE_EMBEDDING_MODEL=doubao-embedding-vision-250615
IMAGE_EMBEDDING_DIMENSIONS=2048
IMAGE_EMBEDDING_BATCH_SIZE=16
IMAGE_EMBEDDING_TIMEOUT_MS=30000
IMAGE_EMBEDDING_MAX_RETRIES=3
IMAGE_VECTOR_COLLECTION=shopmate_product_image_documents
IMAGE_VECTOR_TOP_K=12

LLM_PROVIDER=volcengine-ark
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=Doubao-Seed-2.0-lite
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=1
LLM_MAX_COMPLETION_TOKENS=700
LLM_TEMPERATURE=0.2

# ASR defaults reuse LLM_* when ASR_* values are blank.
# ASR_MODEL / LLM_MODEL must support audio input for POST /api/asr/transcribe.
ASR_PROVIDER=llm-audio
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT_MS=20000
ASR_MAX_COMPLETION_TOKENS=800
ASR_MAX_AUDIO_BYTES=5242880
ASR_LANGUAGE=zh-CN

# Image search defaults keep the endpoint disabled until a vision model is set.
IMAGE_SEARCH_PROVIDER=disabled
IMAGE_SEARCH_BASE_URL=
IMAGE_SEARCH_API_KEY=
IMAGE_SEARCH_MODEL=
IMAGE_SEARCH_TIMEOUT_MS=25000
IMAGE_SEARCH_MAX_IMAGE_BYTES=5242880
IMAGE_SEARCH_MAX_COMPLETION_TOKENS=700
IMAGE_SEARCH_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

RAG_TOP_K=12
