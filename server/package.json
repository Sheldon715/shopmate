{
  "name": "shopmate-server",
  "version": "1.0.0",
  "description": "ShopMate backend scaffold",
  "main": "dist/server.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/scripts/migrate-db.ts",
    "db:rebuild": "tsx src/scripts/rebuild-db.ts",
    "catalog:normalize": "tsx src/scripts/normalize-products.ts",
    "catalog:validate": "tsx src/scripts/validate-products.ts",
    "catalog:import": "tsx src/scripts/import-products.ts",
    "rag:documents": "tsx src/scripts/build-rag-documents.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
